---
// Simple navigation with inline SVG icons
---

<nav class="bg-white border-b-4 border-slate-900 pixel-border">
  <div class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-slate-900 pixel-border border-4 border-slate-900 flex items-center justify-center">
          <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <span class="pixel-font text-xs">DEV_NAME</span>
      </div>

      <div class="flex gap-6">
        <a
          href="#games"
          class="flex items-center gap-2 text-slate-700 hover:text-slate-900 transition-colors pixel-font text-[10px] hover:underline decoration-2 decoration-green-500"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          </svg>
          <span class="hidden sm:inline">Games</span>
        </a>
        <a
          href="#projects"
          class="flex items-center gap-2 text-slate-700 hover:text-slate-900 transition-colors pixel-font text-[10px] hover:underline decoration-2 decoration-green-500"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
          </svg>
          <span class="hidden sm:inline">Projects</span>
        </a>
        <a
          href="#blog"
          class="flex items-center gap-2 text-slate-700 hover:text-slate-900 transition-colors pixel-font text-[10px] hover:underline decoration-2 decoration-green-500"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span class="hidden sm:inline">Blog</span>
        </a>
        <a
          href="#contact"
          class="flex items-center gap-2 text-slate-700 hover:text-slate-900 transition-colors pixel-font text-[10px] hover:underline decoration-2 decoration-green-500"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="hidden sm:inline">Contact</span>
        </a>
      </div>
    </div>
  </div>
</nav>
