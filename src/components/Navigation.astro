---
import { siteConfig } from '../config';
---

<nav class="bg-white border-b-4 border-slate-900">
  <div class="container mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <a href="/">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 flex items-center justify-center overflow-hidden">
            <img src="/logo.svg" alt="Logo" class="w-full h-full object-contain" style="filter: brightness(0);" />
          </div>
          <span class="pixel-font text-lg">{siteConfig.name}</span>
        </div>
      </a>

      <div class="flex gap-6">
        {siteConfig.navigation.map((item) => (
          <a
            href={item.href}
            class="flex items-center gap-2 text-slate-700 hover:text-slate-900 transition-colors pixel-font text-base hover:underline decoration-2 decoration-green-500"
          >
            <span class="hidden sm:inline">{item.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>
