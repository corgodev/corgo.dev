---
// Projects preview section
const projects = [
  {
    title: 'Custom Game Engine',
    description: 'A lightweight 2D game engine built with C++ and OpenGL.',
    tech: ['C++', 'OpenGL', 'SDL2'],
  },
  {
    title: 'Level Editor Tool',
    description: 'Visual editor for creating and testing game levels in real-time.',
    tech: ['React', 'WebGL', 'Node.js'],
  },
  {
    title: 'AI Pathfinding System',
    description: 'Optimized A* pathfinding implementation for large grid-based games.',
    tech: ['C#', 'Unity', 'A*'],
  },
];
---

<section id="projects" class="py-16 bg-slate-50">
  <div class="container mx-auto px-6">
    <div class="flex items-center justify-between mb-8">
      <h2 class="pixel-font text-sm flex items-center gap-2">
        <span class="text-green-600">&gt;&gt;</span> Projects
      </h2>
      <a href="#projects" class="flex items-center gap-2 text-slate-600 hover:text-slate-900 transition-colors text-sm hover:underline decoration-2 decoration-green-500">
        View all
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {projects.map((project) => (
        <div class="bg-white border-4 border-slate-900 pixel-border p-6 hover:border-slate-700 transition-colors cursor-pointer">
          <h3 class="text-lg mb-3">{project.title}</h3>
          <p class="text-slate-600 text-sm mb-4">{project.description}</p>
          <div class="flex flex-wrap gap-2">
            {project.tech.map((tech) => (
              <span class="text-xs px-2 py-1 bg-slate-100 text-slate-700 rounded">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
