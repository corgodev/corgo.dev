---
import { getCollection } from 'astro:content';
import Card from './Card.astro';

// Fetch projects from content collection, sorted by date (newest first)
// Filter out drafts in production
const projects = (await getCollection('projects', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
})).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<section id="projects" class="py-16 bg-slate-50">
  <div class="container mx-auto px-6">
    <div class="flex items-center justify-between mb-8">
      <h2 class="pixel-font text-[10px] flex items-center gap-2">
        <span class="text-green-600">&gt;&gt;</span> PROJECTS
      </h2>
      <a href="#projects" class="flex items-center gap-2 text-slate-600 hover:text-green-600 transition-colors pixel-font text-[10px] hover:underline decoration-2 decoration-green-500">
        VIEW_ALL
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {projects.map((project) => (
        <Card padding="p-6">
          <h3 class="text-lg font-semibold mb-3">{project.data.title}</h3>
          <p class="text-slate-600 text-sm mb-4">{project.data.description}</p>
          <div class="flex flex-wrap gap-2">
            {project.data.tech.map((tech) => (
              <span class="pixel-font text-[8px] px-2 py-1 bg-green-100 text-slate-900 border-2 border-slate-900">
                {tech}
              </span>
            ))}
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>
