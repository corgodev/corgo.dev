---
import { getCollection } from 'astro:content';
import Card from './Card.astro';
import SectionHeader from './SectionHeader.astro';

// Fetch projects from content collection, sorted by date (newest first)
// Filter out drafts in production
const projects = (await getCollection('projects', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
})).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<section id="projects" class="py-16 bg-slate-50">
  <div class="container mx-auto px-6">
    <SectionHeader title="PROJECTS" viewAllHref="#projects" />

    <div class="grid md:grid-cols-3 gap-6">
      {projects.map((project) => (
        <Card padding="p-6">
          <h3 class="text-lg font-semibold mb-3">{project.data.title}</h3>
          <p class="text-slate-600 text-sm mb-4">{project.data.description}</p>
          <div class="flex flex-wrap gap-2">
            {project.data.tech.map((tech) => (
              <span class="pixel-font text-[8px] px-2 py-1 bg-green-100 text-slate-900 border-2 border-slate-900">
                {tech}
              </span>
            ))}
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>
