---
import { getCollection } from 'astro:content';
import Card from './Card.astro';
import SectionHeader from './SectionHeader.astro';
import Badge from './Badge.astro';

// Fetch games from content collection, sorted by date (newest first)
// Filter out drafts in production
const games = (await getCollection('games', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
})).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<section id="games" class="py-16 bg-white">
  <div class="container mx-auto px-6">
    <SectionHeader title="GAMES" viewAllHref="#games" />

    <div class="grid md:grid-cols-3 gap-6">
      {games.map((game) => (
        <Card padding="p-0">
          <div class="aspect-video bg-slate-200 overflow-hidden">
            <img
              src={game.data.image}
              alt={game.data.title}
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-lg font-semibold">{game.data.title}</h3>
              <Badge variant="small">
                {game.data.status}
              </Badge>
            </div>
            <p class="text-slate-600 text-sm">{game.data.description}</p>
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>
