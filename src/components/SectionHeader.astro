---
interface Props {
  title: string;
  viewAllHref?: string;
  viewAllText?: string;
}

const {
  title,
  viewAllHref,
  viewAllText = 'VIEW_ALL',
} = Astro.props;
---

<div class="flex items-center justify-between mb-8">
  <h2 class="pixel-font text-[10px] flex items-center gap-2">
    <span class="text-green-600">&gt;&gt;</span> {title}
  </h2>
  {viewAllHref && (
    <a href={viewAllHref} class="flex items-center gap-2 text-slate-600 hover:text-green-600 transition-colors pixel-font text-[10px] hover:underline decoration-2 decoration-green-500">
      {viewAllText}
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>
  )}
</div>
