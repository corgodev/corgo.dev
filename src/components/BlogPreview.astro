---
import { getCollection } from 'astro:content';
import Card from './Card.astro';
import SectionHeader from './SectionHeader.astro';

// Fetch blog posts from content collection, sorted by date (newest first)
// Filter out drafts in production
const posts = (await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
})).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Helper to format date
function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  });
}
---

<section id="blog" class="py-16 bg-white">
  <div class="container mx-auto px-6">
    <SectionHeader title="BLOG" viewAllHref="/blog" />

    <div class="space-y-6">
      {posts.map((post) => (
        <Card href={`/blog/${post.slug}`} padding="p-6">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg text-slate-900 hover:text-green-600 transition-colors">{post.data.title}</h3>
            {post.data.readTime && (
              <span class="pixel-font text-[10px] text-slate-500">{post.data.readTime}</span>
            )}
          </div>
          <p class="text-slate-600 text-sm mb-2">{post.data.description}</p>
          <time class="pixel-font text-[10px] text-slate-500">{formatDate(post.data.date)}</time>
        </Card>
      ))}
    </div>
  </div>
</section>
