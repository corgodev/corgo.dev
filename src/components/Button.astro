---
interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}

const {
  variant = 'primary',
  href,
  type = 'button',
  class: className = '',
} = Astro.props;

const baseClasses = 'inline-flex items-center gap-2 px-4 py-2 transition-colors pixel-font text-[10px] border-2 border-slate-900';

const variants = {
  primary: 'bg-slate-900 text-white hover:bg-slate-700',
  secondary: 'bg-white text-slate-900 hover:bg-slate-100',
};

const classes = `${baseClasses} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
