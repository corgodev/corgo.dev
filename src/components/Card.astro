---
interface Props {
  href?: string;
  class?: string;
  padding?: string;
}

const {
  href,
  class: className = '',
  padding = 'p-6 md:p-8',
} = Astro.props;

const baseClasses = 'border-4 border-slate-900 bg-white hover:shadow-[8px_8px_0px_0px_rgba(15,23,42,1)] transition-all';
const combinedClasses = `${baseClasses} ${className}`;
---

{href ? (
  <a href={href} class={`${combinedClasses} ${padding} block`}>
    <slot />
  </a>
) : (
  <div class={`${combinedClasses} ${padding}`}>
    <slot />
  </div>
)}
